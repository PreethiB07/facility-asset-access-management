generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum Role {
  USER
  MANAGER
  ADMIN
}

enum AccessType {
  TEMPORARY
  PERMANENT
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  facilities          Facility[]
  areas               Area[]
  assets              Asset[]
  accessRequests      AccessRequest[]
  approvalDelegations ApprovalDelegation[]
  approvalHistory     ApprovalHistory[]
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  email        String
  passwordHash String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company                 Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAccessRequests   AccessRequest[]      @relation("CreatedAccessRequests")
  requestedForAccessRequests AccessRequest[]   @relation("RequestedForAccessRequests")
  approvedRequests        AccessRequest[]      @relation("ApproverAccessRequests")
  delegationsGiven        ApprovalDelegation[] @relation("DelegatingManager")
  delegationsReceived     ApprovalDelegation[] @relation("DelegatedManager")
  approvalHistoryActions  ApprovalHistory[]

  @@unique([companyId, email])
  @@index([companyId])
}

model Facility {
  id               String   @id @default(uuid())
  companyId        String
  name             String
  description      String?
  isActive         Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  areas          Area[]
  assets         Asset[]
  accessRequests AccessRequest[]

  @@index([companyId])
}

model Area {
  id               String   @id @default(uuid())
  companyId        String
  facilityId       String
  name             String
  description      String?
  isActive         Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  facility       Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  assets         Asset[]
  accessRequests AccessRequest[]

  @@index([companyId])
  @@index([facilityId])
}

model Asset {
  id               String   @id @default(uuid())
  companyId        String
  facilityId       String
  areaId           String?
  name             String
  description      String?
  isActive         Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  facility       Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  area           Area?           @relation(fields: [areaId], references: [id], onDelete: Restrict)
  accessRequests AccessRequest[]

  @@index([companyId])
  @@index([facilityId])
  @@index([areaId])
}

model AccessRequest {
  id              String              @id @default(uuid())
  companyId       String
  createdById     String
  requestedForId  String
  facilityId      String?
  areaId          String?
  assetId         String?
  accessType      AccessType
  startAt         DateTime
  endAt           DateTime?
  reason          String
  status          AccessRequestStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy    User              @relation("CreatedAccessRequests", fields: [createdById], references: [id], onDelete: Restrict)
  requestedFor User              @relation("RequestedForAccessRequests", fields: [requestedForId], references: [id], onDelete: Restrict)
  facility     Facility?         @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  area         Area?             @relation(fields: [areaId], references: [id], onDelete: Restrict)
  asset        Asset?            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  approvedBy   User?             @relation("ApproverAccessRequests", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalHistory ApprovalHistory[]

  @@index([companyId])
  @@index([createdById])
  @@index([requestedForId])
  @@index([status])
  @@index([facilityId])
  @@index([areaId])
  @@index([assetId])
  @@index([startAt])
  @@index([endAt])
}

model ApprovalDelegation {
  id                  String   @id @default(uuid())
  companyId           String
  delegatingManagerId String
  delegatedManagerId  String
  effectiveFrom       DateTime
  effectiveUntil      DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company           Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  delegatingManager User    @relation("DelegatingManager", fields: [delegatingManagerId], references: [id], onDelete: Restrict)
  delegatedManager  User    @relation("DelegatedManager", fields: [delegatedManagerId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([delegatingManagerId])
  @@index([delegatedManagerId])
  @@index([effectiveFrom, effectiveUntil])
}

model ApprovalHistory {
  id              String           @id @default(uuid())
  companyId       String
  accessRequestId String
  actorId         String
  decision        ApprovalDecision
  comment         String?
  createdAt       DateTime         @default(now())

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  accessRequest AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Restrict)
  actor         User          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([accessRequestId])
  @@index([actorId])
}
