generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum Role {
  USER
  MANAGER
  ADMIN
}

enum AccessType {
  TEMPORARY
  PERMANENT
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  facilities     Facility[]
  areas          Area[]
  assets         Asset[]
  accessRequests AccessRequest[]
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  email        String
  passwordHash String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  accessRequests   AccessRequest[] @relation("RequesterAccessRequests")
  approvedRequests AccessRequest[] @relation("ApproverAccessRequests")

  @@unique([companyId, email])
  @@index([companyId])
}

model Facility {
  id               String   @id @default(uuid())
  companyId        String
  name             String
  description      String?
  isActive         Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  areas          Area[]
  assets         Asset[]
  accessRequests AccessRequest[]

  @@index([companyId])
}

model Area {
  id               String   @id @default(uuid())
  companyId        String
  facilityId       String
  name             String
  description      String?
  isActive         Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  facility       Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  assets         Asset[]
  accessRequests AccessRequest[]

  @@index([companyId])
  @@index([facilityId])
}

model Asset {
  id               String   @id @default(uuid())
  companyId        String
  facilityId       String
  areaId           String?
  name             String
  description      String?
  isActive         Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  facility       Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  area           Area?           @relation(fields: [areaId], references: [id], onDelete: Restrict)
  accessRequests AccessRequest[]

  @@index([companyId])
  @@index([facilityId])
  @@index([areaId])
}

model AccessRequest {
  id              String              @id @default(uuid())
  companyId       String
  requesterId     String
  facilityId      String?
  areaId          String?
  assetId         String?
  accessType      AccessType
  startAt         DateTime
  endAt           DateTime?
  reason          String
  status          AccessRequestStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requester  User      @relation("RequesterAccessRequests", fields: [requesterId], references: [id], onDelete: Restrict)
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  area       Area?     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  approvedBy User?     @relation("ApproverAccessRequests", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([requesterId])
  @@index([status])
  @@index([facilityId])
  @@index([areaId])
  @@index([assetId])
  @@index([startAt])
  @@index([endAt])
}
