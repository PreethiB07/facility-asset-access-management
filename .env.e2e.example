# Copy to .env.e2e and fill values from docs/demo-accounts.md (development only).
# Do not commit .env.e2e — it is gitignored.

E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:3001

# Company A — Acme Corporation
E2E_ACME_USER_EMAIL=demo.user@example.com
E2E_ACME_USER_PASSWORD=
E2E_ACME_MANAGER_EMAIL=demo.manager@example.com
E2E_ACME_MANAGER_PASSWORD=
E2E_ACME_ADMIN_EMAIL=demo.admin@example.com
E2E_ACME_ADMIN_PASSWORD=

# Company B — Globex Industries
E2E_GLOBEX_USER_EMAIL=globex.user@example.com
E2E_GLOBEX_USER_PASSWORD=
E2E_GLOBEX_MANAGER_EMAIL=globex.manager@example.com
E2E_GLOBEX_MANAGER_PASSWORD=
E2E_GLOBEX_ADMIN_EMAIL=globex.admin@example.com
E2E_GLOBEX_ADMIN_PASSWORD=
